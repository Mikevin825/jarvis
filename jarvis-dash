#!/usr/bin/env bash
# Open JARVIS as a single window: the galaxy and the mind map, side by side.
#
# This used to take two terminal windows — one for the galaxy dev server, one
# for the mind-map server. Both are started here, detached, and the dashboard
# is opened in the browser. Closing the browser does not stop the servers, so
# the window can be reopened without starting them again.
#
# Usage:
#   ./jarvis-dash            start what is needed, open the dashboard
#   ./jarvis-dash --status   report which servers are running
#   ./jarvis-dash --stop     stop the servers this script started
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$DIR/.venv/bin/python"
DASH_PORT="${JARVIS_DESKTOP_PORT:-8790}"
MIND_PORT="${JARVIS_MINDMAP_PORT:-8792}"
DASH_URL="http://127.0.0.1:${DASH_PORT}/"
LOG_DIR="$DIR/state/desktop"
PIDS_FILE="$LOG_DIR/servers.pids"

mkdir -p "$LOG_DIR"

log() { printf '%s\n' "$*"; }

# Is something already listening on this port?
listening() {
  if command -v ss >/dev/null 2>&1; then
    ss -tln 2>/dev/null | grep -q ":$1[[:space:]]"
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
  fi
}

start_dashboard() {
  if listening "$DASH_PORT"; then
    log "  dashboard already running on :$DASH_PORT"
    return 0
  fi
  log "  starting dashboard on :$DASH_PORT"
  ( cd "$DIR" && nohup "$PY" galaxy_server.py \
      >>"$LOG_DIR/dashboard.log" 2>&1 & echo $! >>"$PIDS_FILE" )
  for _ in $(seq 1 40); do
    listening "$DASH_PORT" && return 0
    sleep 0.25
  done
  log "  dashboard did not come up; see $LOG_DIR/dashboard.log"
  return 1
}

start_mindmap() {
  if listening "$MIND_PORT"; then
    log "  mind map already running on :$MIND_PORT"
    return 0
  fi
  log "  starting mind map on :$MIND_PORT"
  ( cd "$DIR" && nohup "$PY" mindmap_server.py \
      >>"$LOG_DIR/mindmap.log" 2>&1 & echo $! >>"$PIDS_FILE" )
  for _ in $(seq 1 40); do
    listening "$MIND_PORT" && return 0
    sleep 0.25
  done
  log "  mind map did not come up; see $LOG_DIR/mindmap.log"
  return 1
}

stop_all() {
  if [[ -f "$PIDS_FILE" ]]; then
    while read -r pid; do
      [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done <"$PIDS_FILE"
    rm -f "$PIDS_FILE"
    log "stopped the servers this script started"
  else
    log "no recorded servers to stop"
  fi
}

status() {
  if listening "$DASH_PORT"; then log "  dashboard :$DASH_PORT  up"; else log "  dashboard :$DASH_PORT  down"; fi
  if listening "$MIND_PORT"; then log "  mind map  :$MIND_PORT  up"; else log "  mind map  :$MIND_PORT  down"; fi
}

case "${1:-}" in
  --status) status; exit 0 ;;
  --stop)   stop_all; exit 0 ;;
  --help|-h)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

if [[ ! -x "$PY" ]]; then
  log "No virtualenv at $DIR/.venv" >&2
  exit 1
fi

log "Opening JARVIS…"
start_mindmap
start_dashboard
status
log "  opening $DASH_URL"

# Open in the user's browser. Fall back through the usual suspects so this
# works from a terminal, a file manager, or a desktop entry.
for opener in xdg-open open sensible-browser; do
  if command -v "$opener" >/dev/null 2>&1; then
    "$opener" "$DASH_URL" >/dev/null 2>&1 &
    exit 0
  fi
done

log "No browser launcher found; open $DASH_URL yourself."
