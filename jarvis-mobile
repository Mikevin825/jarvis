#!/usr/bin/env bash
# Launch the JARVIS mobile server.
#
# Serves the installable web app on the LAN. Prints the phone URL and the
# pairing token on startup. Resolves the venv relative to this file so it
# works from any working directory.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$DIR/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
    echo "No virtualenv found at $DIR/.venv" >&2
    echo "Create it with:  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
    exit 1
fi

cd "$DIR"
exec "$PY" mobile_server.py "$@"
