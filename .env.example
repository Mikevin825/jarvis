# Copy this file to `.env` and fill in your real keys.
# `.env` is git-ignored. Never paste a key into a source file.

# Brain (Tier 1) — required when brain.provider is "gemini"
GEMINI_API_KEY=

# Ears (Tier 3) — speech-to-text
DEEPGRAM_API_KEY=

# Mouth (Tier 3) — text-to-speech
ELEVENLABS_API_KEY=
