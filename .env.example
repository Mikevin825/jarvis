# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored. Never paste a key into a source file, and never commit
# this file with real values in it — it is a template, and templates get
# committed.
#
# Get keys from:
#   Gemini      https://aistudio.google.com/apikey
#   Deepgram    https://console.deepgram.com/
#   ElevenLabs  https://elevenlabs.io/app/settings/api-keys
#   Picovoice   https://console.picovoice.ai/   (free, no card — wake word)

# Brain (Tier 1) — required when brain.provider is "gemini"
GEMINI_API_KEY=

# Ears (Tier 3) — speech-to-text
DEEPGRAM_API_KEY=

# Mouth (Tier 3) — text-to-speech
ELEVENLABS_API_KEY=

# Wake word (Tier 3) — on-device detection, run with: ./jarvis-wake
PORCUPINE_ACCESS_KEY=
